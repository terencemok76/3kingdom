[sub_resource type="Shader" id="Shader_left_panel_transparency"]
code = "shader_type canvas_item;

uniform float inner_alpha : hint_range(0.0, 1.0) = 0.72;

void fragment() {
    vec4 tex = texture(TEXTURE, UV);
    float brightness = max(tex.r, max(tex.g, tex.b));
    float ornament_mask = smoothstep(0.18, 0.48, brightness);
    tex.a *= mix(inner_alpha, 1.0, ornament_mask);
    COLOR = tex * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_left_panel_transparency"]
shader = SubResource("Shader_left_panel_transparency")
shader_parameter/inner_alpha = 0.72

